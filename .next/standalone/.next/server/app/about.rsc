14:["$","section",null,{"id":"message","children":["$","section",null,{"id":"message","className":"relative overflow-hidden bg-gradient-to-r from-white via-[#eaf0fd] to-[#b7cbf6] py-16 md:py-20 scroll-mt-24","children":[["$","div",null,{"className":"hidden lg:block absolute inset-y-0 right-0 w-[52%] pointer-events-none","children":[["$","$L11",null,{"src":"https://ik.imagekit.io/munTasIr/SAThread/mdmessage.png?updatedAt=1790675594550","alt":"Team collaborating around a table","fill":true,"sizes":"52vw","className":"object-cover object-center"}],["$","div",null,{"className":"absolute inset-y-0 left-0 w-1/3 bg-gradient-to-r from-[#eaf0fd] to-transparent"}]]}],["$","div",null,{"className":"container mx-auto px-6 relative","children":[["$","div",null,{"className":"lg:max-w-[58%]","children":[["$","p",null,{"className":"text-primary text-[12px] font-bold uppercase tracking-[2px] mb-6","children":"Message from Managing Director"}],["$","div",null,{"className":"space-y-5 text-gray-700 text-[14px] leading-[1.7]","children":[["$","p",null,{"children":"At SA Thread & Accessories Ltd, we believe that excellence is built by integrating quality, commitment, and trust. Since the beginning of our operation, we have been dedicated to serving the garments industry with premium accessories solutions that meet international standards and customer expectations."}],["$","p",null,{"children":["Bangladesh has established itself as one of the ","world's"," leading apparel manufacturers, and we are really proud to contribute to this growth by supporting our valued clients with reliable, and sustainable accessories products. Our commitment to continuous improvement, ethical business practices, and timely delivery has helped us build long-term partnerships with our clients."]}],["$","p",null,{"children":"We understand that in our current competitive market, success depends not only on product quality but also on responsibility, adaptability, and customer satisfaction. Therefore, our team continuously works to enhance operational efficiency, adapt modern technologies, and maintain environmentally conscious practices."}],["$","p",null,{"children":"I would like to express my sincere gratitude to our clients, partners, employees, and stakeholders for their trust and support. Together, we will continue to move forward with integrity, innovation, and a shared vision for sustainable growth."}]]}],["$","div",null,{"className":"mt-8 text-gray-700 text-[14px] leading-[1.7]","children":["Thank you",["$","br",null,{}],"Mohammed Shahidul Islam",["$","br",null,{}],"Managing Director, SA Thread & Accessories Ltd."]}]]}],["$","div",null,{"className":"lg:hidden mt-12 flex justify-center","children":["$","div",null,{"className":"relative w-full max-w-[420px] aspect-square","children":["$","$L11",null,{"src":"https://ik.imagekit.io/munTasIr/SAThread/mdmessage.png?updatedAt=1790675594550","alt":"Team collaborating around a table","fill":true,"sizes":"(max-width: 768px) 100vw, 420px","className":"object-contain"}]}]}]]}]]}]}]
