RewriteEngine On

# Bypass Node.js for static files and serve directly to fix MIME type issues
RewriteRule ^_next/static/(.*)$ next_static/$1 [L]

# Serve public files (like logo.jpg) directly
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^(.*)$ public/$1 [L]

# DO NOT REMOVE. GENERATED BY NODE.JS APP
PassengerAppRoot "/home/sathread/sathread.com.bd"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE
