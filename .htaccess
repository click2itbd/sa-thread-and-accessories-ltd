RewriteEngine On

# --- Security Settings ---
# Block access to sensitive files
<FilesMatch "^\.([Ee][Nn][Vv]|[Gg][Ii][Tt])">
    Order allow,deny
    Deny from all
</FilesMatch>
# Disable directory listing
Options -Indexes
# -------------------------

# Static files are handled natively by Node.js server.js in standalone mode

# DO NOT REMOVE. GENERATED BY NODE.JS APP
PassengerAppRoot "/home/sathread/sathread.com.bd"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE
